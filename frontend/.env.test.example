# Test Environment Configuration
# All networks must be defined even if not actively used

# Default environment for tests
VITE_DEFAULT_ENVIRONMENT=local

# Environment mode
VITE_ENV=dev

# Chain IDs for all networks (all must be defined)
VITE_CHAIN_IDS={"local":"0","testnet":"0","mainnet":"9889"}

# RPC URLs for all networks (all must be defined)
VITE_RPC_URLS={"local":"http://localhost:4000/v1/graphql","testnet":"https://testnet.fuel.network/v1/graphql","mainnet":"https://mainnet.fuel.network/v1/graphql"}

# Indexer URLs for all networks (all must be defined)
VITE_INDEXER_URLS={"local":"http://localhost:4350/graphql","testnet":"https://starboard.squids.live/starboard-testnet@test2/api/graphql","mainnet":"https://starboard.squids.live/starboard-mainnet/api/graphql"}

